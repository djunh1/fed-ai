{
  "version": "0.2.0",
  "configurations": [
    // ---- infrastructure -------------------------------------------------
    {
      "name": "Debug: http.get",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/temp/debug_http.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "justMyCode": true,
      "env": { "PYTHONPATH": "${workspaceFolder}" }
    },
    {
      "name": "Debug: RateLimiter",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/temp/debug_rate_limiter.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "justMyCode": true,
      "env": { "PYTHONPATH": "${workspaceFolder}" }
    },

    // ---- federalreserve.gov ---------------------------------------------
    {
      "name": "Debug: fedgov index URLs",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/temp/debug_fedgov.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "justMyCode": true,
      "env": { "PYTHONPATH": "${workspaceFolder}" }
    },
    {
      "name": "Debug: parse_index",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/temp/debug_parse_index.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "justMyCode": true,
      "env": { "PYTHONPATH": "${workspaceFolder}" }
    },
    {
      "name": "Debug: iter_documents",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/temp/debug_iter_documents.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "justMyCode": true,
      "env": { "PYTHONPATH": "${workspaceFolder}" }
    },
    {
      "name": "Debug: fetch_press_index",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/temp/debug_press_index.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "justMyCode": true,
      "env": { "PYTHONPATH": "${workspaceFolder}" }
    },
    {
      "name": "Debug: try pattern (regex scratchpad)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/temp/try_pattern.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "justMyCode": true,
      "env": { "PYTHONPATH": "${workspaceFolder}" }
    },

    // ---- FRASER ----------------------------------------------------------
    {
      "name": "Debug: FraserClient",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/temp/debug_fraser.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "justMyCode": true,
      "env": { "PYTHONPATH": "${workspaceFolder}" }
    },
    {
      // Steps 0-2 are offline (saved samples + a fake client); 3-5 need
      // FED_API_KEY and the network.
      "name": "Debug: FraserApi (adapter)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/temp/debug_fraser_api.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "justMyCode": true,
      "env": { "PYTHONPATH": "${workspaceFolder}" }
    },

    // ---- persistence and pipeline ---------------------------------------
    {
      "name": "Debug: persistence (dispatcher + Mongo)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/temp/debug_persistence.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "justMyCode": true,
      "env": { "PYTHONPATH": "${workspaceFolder}" }
    },
    {
      // Read-only. Judge the stored corpus by eye: coverage, a quality scan
      // for nav chrome and OCR damage, and documents printed for reading.
      "name": "Debug: browse the corpus",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/temp/debug_corpus.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "justMyCode": true,
      "env": { "PYTHONPATH": "${workspaceFolder}" }
    },
    {
      // The local orchestrator runs steps in THIS process, so breakpoints
      // inside build_fed_manifest / extract_fed_text are hit normally.
      "name": "Debug: ETL pipeline — fed.gov",
      "type": "debugpy",
      "request": "launch",
      "module": "tools.run",
      "args": ["--run-etl", "--no-cache"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "justMyCode": true,
      "env": { "PYTHONPATH": "${workspaceFolder}" }
    },
    {
      // The monthly update: 2 index fetches instead of 86.
      "name": "Debug: ETL pipeline — fed.gov incremental",
      "type": "debugpy",
      "request": "launch",
      "module": "tools.run",
      "args": [
        "--run-etl",
        "--no-cache",
        "--etl-config-filename",
        "fed_data_etl_incremental.yaml"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "justMyCode": true,
      "env": { "PYTHONPATH": "${workspaceFolder}" }
    },
    {
      // Same pipeline, sources: [fraser]. Needs FED_API_KEY.
      "name": "Debug: ETL pipeline — FRASER",
      "type": "debugpy",
      "request": "launch",
      "module": "tools.run",
      "args": [
        "--run-etl",
        "--no-cache",
        "--etl-config-filename",
        "fraser_data_etl.yaml"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "justMyCode": true,
      "env": { "PYTHONPATH": "${workspaceFolder}" }
    },

    // ---- tests -----------------------------------------------------------
    {
      "name": "Debug: pytest (current file)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["${file}", "-v"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "justMyCode": true
    },
    {
      "name": "Debug: pytest (all)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["tests/", "-v"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "justMyCode": true
    },

    // ---- catch-all -------------------------------------------------------
    {
      "name": "Debug: current file",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "justMyCode": true,
      "env": { "PYTHONPATH": "${workspaceFolder}" }
    }
  ]
}
